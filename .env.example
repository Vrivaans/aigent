# AIgent v1.0 Local Configuration

# Backend API Port
PORT=3000

# Database Configuration (GORM) - Matches docker-compose.yml out of the box
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=aigent
DB_SSLMODE=disable

# Opcional (p. ej. Dokploy): si está definida, se intenta primero; debe incluir host tras user:pass (postgresql://user:pass@HOST:5432/dbname?sslmode=disable).
# Si la contraseña tiene ":" o "@", codificala en la URL. Formato alternativo: host=... port=... user=... password=... dbname=...
# DATABASE_URL=postgresql://user:pass@db-host:5432/dbname?sslmode=disable

# LLM Security - Cifrado AES-256 (32 caracteres exactos)
# Cifra API keys, tokens MCP y otros secretos persistidos en PostgreSQL.
DB_ENCRYPTION_KEY=tu_secreto_super_seguro_de_32char

# JWT de sesión (HS256) — independiente del cifrado de base de datos (mín. 16 caracteres)
JWT_SECRET=tu_secreto_jwt_largo_y_aleatorio_aqui

# Credenciales de Administración (Hackathon Login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=aigent_secret_2026

# HandsAI Integration (The "Hands")
# URL del backend o servidor MCP que expone las herramientas
HANDSAI_URL=http://localhost:8080/mcp
HANDSAI_TOKEN=tu_token_handsai_aqui
